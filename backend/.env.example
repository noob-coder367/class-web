# === Server ===
PORT=4000
NODE_ENV=development

# Domain của frontend (Vite dev server) để cấu hình CORS
FRONTEND_ORIGIN=http://localhost:5173

# === Supabase ===
# Lấy trong Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ⚠️ SERVICE ROLE KEY - CÓ TOÀN QUYỀN, BỎ QUA RLS.
# CHỈ dùng ở backend. KHÔNG BAO GIỜ commit giá trị thật hay đưa vào frontend.
SUPABASE_SERVICE_ROLE_KEY=

# === Bảo mật ứng dụng ===
# Mã bí mật để đăng ký làm "Thành viên 10A4".
# Đổi giá trị này thành mã thật, KHÔNG dùng giá trị mặc định trong code cũ.
SECRET_CODE=A4-NHH-MaiDinh

# === GitHub (ảnh website: giáo viên, ảnh lớp, banner) ===
# Fine-grained PAT với Contents: Read and write trên repo class-web.
# Bắt buộc nếu muốn admin thêm/xóa ảnh từ panel.
GITHUB_TOKEN=
GITHUB_OWNER=noob-coder367
GITHUB_REPO=class-web
GITHUB_BRANCH=main

# === Web Push (VAPID) ===
# Tạo khóa: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@10a4.local

# Public origin của API (không slash cuối). Dùng để Service Worker gửi receipt.
# Ví dụ: https://your-backend.onrender.com/api
# Nếu để trống, backend tự suy từ host request / RENDER_EXTERNAL_URL.
API_PUBLIC_URL=

# === AI Assistant (backend only) ===
# Không đưa các biến này vào frontend và không commit giá trị thật.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# === AI grading (disabled until the database migration is run and keys are set) ===
AI_GRADING_ENABLED=false
AI_GRADING_CONCURRENCY=2
AI_GRADING_POLL_MS=5000
AI_GRADING_MAX_ATTEMPTS=3
AI_GRADING_JOB_TIMEOUT_MS=180000
AI_GRADING_STORAGE_TIMEOUT_MS=30000
AI_GRADING_GEMINI_TIMEOUT_MS=60000
AI_GRADING_OCR_TIMEOUT_MS=45000
AI_GRADING_GROQ_TIMEOUT_MS=90000
AI_GRADING_RETRY_BASE_MS=1000
AI_GRADING_RETRY_MAX_MS=60000
AI_GRADING_STUCK_AFTER_MS=300000
AI_GRADING_OCR_CONFIDENCE_THRESHOLD=0.72
AI_GRADING_REVIEW_CONFIDENCE_THRESHOLD=0.65
AI_GRADING_MAX_IMAGES=20
AI_GRADING_MAX_IMAGE_BYTES=15728640
AI_GRADING_MAX_TOTAL_BYTES=62914560
AI_GRADING_MAX_PDF_PAGES=30
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_SECONDARY_MODEL=gemini-3.6-flash
OCR_SPACE_API_KEY=
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image
