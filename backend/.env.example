# === Server ===
PORT=4000
NODE_ENV=development

# Domain của frontend (Vite dev server) để cấu hình CORS
FRONTEND_ORIGIN=http://localhost:5173

# === Supabase ===
# Lấy trong Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ⚠️ SERVICE ROLE KEY - CÓ TOÀN QUYỀN, BỎ QUA RLS.
# CHỈ dùng ở backend. KHÔNG BAO GIỜ commit giá trị thật hay đưa vào frontend.
SUPABASE_SERVICE_ROLE_KEY=

# === Bảo mật ứng dụng ===
# Mã bí mật để đăng ký làm "Thành viên 10A4".
# Đổi giá trị này thành mã thật, KHÔNG dùng giá trị mặc định trong code cũ.
SECRET_CODE=A4-NHH-MaiDinh

# === GitHub (ảnh website: giáo viên, ảnh lớp, banner) ===
# Fine-grained PAT với Contents: Read and write trên repo class-web.
# Bắt buộc nếu muốn admin thêm/xóa ảnh từ panel.
GITHUB_TOKEN=
GITHUB_OWNER=noob-coder367
GITHUB_REPO=class-web
GITHUB_BRANCH=main

# === Web Push (VAPID) ===
# Tạo khóa: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@10a4.local

# Public origin của API (không slash cuối). Dùng để Service Worker gửi receipt.
# Ví dụ: https://your-backend.onrender.com/api
# Nếu để trống, backend tự suy từ host request / RENDER_EXTERNAL_URL.
API_PUBLIC_URL=

# === AI Assistant (backend only) ===
# Không đưa các biến này vào frontend và không commit giá trị thật.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
