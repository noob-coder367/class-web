# === Server ===
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# === Supabase (server only) ===
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# === AI tạo câu hỏi (server only, KHÔNG đưa ra frontend) ===
# Provider hiện hỗ trợ: groq. Để trống GROQ_API_KEY thì chức năng AI trả 503 "chưa được cấu hình".
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Chưa dùng ở phase này
GEMINI_API_KEY=
OCR_SPACE_API_KEY=
