# === Bảo mật ứng dụng ===
# Mã bí mật để đăng ký làm "Thành viên 10A4".
# Đổi giá trị này thành mã thật, KHÔNG dùng giá trị mặc định trong code cũ.
SECRET_CODE=A4-NHH-MaiDinh

# === GitHub (ảnh website: giáo viên, ảnh lớp, banner) ===
