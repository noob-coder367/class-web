# URL của backend (Node/Express) đang chạy
VITE_API_BASE_URL=http://localhost:4000/api

# === Supabase (CHỈ dùng ANON / PUBLISHABLE KEY ở đây) ===
# Lấy trong Supabase Dashboard > Project Settings > API
# Anon key được thiết kế để công khai, an toàn khi đưa vào frontend,
# miễn là Row Level Security (RLS) được cấu hình đúng ở Supabase.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ⚠️ KHÔNG BAO GIỜ đặt SUPABASE_SERVICE_ROLE_KEY hay SECRET_CODE ở đây.
# Những giá trị đó chỉ tồn tại trong backend/.env
